{
  "name": "@harjs/react-ui",
  "version": "2.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "(React | Next) is a ui library.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/libs/core/application/contexts/index.d.ts",
      "import": "./dist/libs/core/application/contexts/index.js"
    },
    "./hooks": {
      "types": "./dist/libs/core/application/hooks/index.d.ts",
      "import": "./dist/libs/core/application/hooks/index.js"
    },
    "./types": {
      "types": "./dist/libs/infrastructure/types/index.d.ts",
      "import": "./dist/libs/infrastructure/types/index.js"
    },
    "./utils": {
      "types": "./dist/libs/infrastructure/shared/index.d.ts",
      "import": "./dist/libs/infrastructure/shared/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "homepage": "https://github.com/kaancetin-f/harjs-design-react-ui#readme",
  "bugs": {
    "url": "https://github.com/kaancetin-f/harjs-design-react-ui/issues"
  },
  "scripts": {
    "build": "npm run clean && tsc && cp -r ./src/assets dist/",
    "no-css-build": "npm run clean && tsc && cp -r ./src/assets dist/",
    "clean": "rm -rf dist/",
    "docs:dev": "npm run dev --prefix docs",
    "docs:build": "npm run build --prefix docs",
    "docs:start": "npm run start --prefix docs",
    "docs:docker": "docker build -t harjs-design ./docs && docker run --rm -p 3000:3000 --name harjs-design harjs-design"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaancetin-f/harjs-design-react-ui.git"
  },
  "keywords": [
    "react",
    "next",
    "ui",
    "design"
  ],
  "author": "Kaan ÇETİN",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@harjs/translation": "^1.0.1"
  }
}
